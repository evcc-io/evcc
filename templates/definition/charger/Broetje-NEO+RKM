# ==========================================
# EVCC METERS & CHARGERS CONFIGURATION
# Modbus Register based on:
# "NEO-RKM 7734937 - 02 - 17082021"
# ==========================================
template: broetje-neo-rkm
products:
  - brand: Brötje
    description:
      generic: NEO + RKM
      en: NEO + RKM
      de: NEO + RKM
group: heating
capabilities: ["meter", "dim"]
requirements:
  description:
    en: |
      The heat pump must be configured for Modbus-controlled PV operation.
      In the service menu, enable requirement profile 3 and set the PV source to "Modbus".
      This template uses register 125 to send the power setpoint in watts.

      The requirement profile must be enabled at the heat pump service level for the heat pump to react to the power setpoint.
      Service code "0112" opens settings that can damage the system. Changes must only be made by qualified personnel.
    de: |
      Die Wärmepumpe muss für den Modbus-gesteuerten PV-Betrieb konfiguriert sein.
      Im Service-Menü muss das Anforderungsprofil 3 aktiviert und die PV-Auswahl auf "Modbus" gesetzt werden.
      Dieses Template verwendet Register 125 zur Vorgabe der Leistung in Watt.

      Damit die Wärmepumpe auf die Leistungsvorgabe reagiert, muss das Anforderungsprofil auf der Service-Ebene der Wärmepumpe aktiviert sein.
      Der Service-Code "0112" öffnet Einstellungen, die das System beschädigen können. Änderungen dürfen nur durch qualifiziertes Fachpersonal vorgenommen werden.

params:
  - name: host
    description:
      en: Hostname or IP address
      de: Hostname oder IP-Adresse
    help:
      en: Modbus TCP host of the Brötje heat pump.
      de: Modbus-TCP-Host der Brötje-Wärmepumpe.
    example: 192.168.1.50
  - name: port
    description:
      en: Modbus TCP port
      de: Modbus-TCP-Port
    help:
      en: Port used for the Modbus TCP connection.
      de: Port für die Modbus-TCP-Verbindung.
    default: 502
  - name: id
    description:
      en: Modbus unit ID
      de: Modbus-Geräte-ID
    help:
      en: Modbus slave ID configured on the heat pump.
      de: Modbus-Slave-ID, die an der Wärmepumpe konfiguriert ist.
    default: 1

render: |
  type: heatpump

  # 1. Power measurement (current power draw)
  power:
    source: modbus
    uri: {{ joinHostPort .host .port }}
    id: {{ .id }}
    register:
      address: 70
      type: input
      decode: uint32

  # 2. Warm water temperature. evcc exposes this as the heat pump temperature.
  temp:
    source: modbus
    uri: {{ joinHostPort .host .port }}
    id: {{ .id }}
    register:
      address: 11
      type: input
      decode: int16
    scale: 0.1

  # 3. Buffer temperature. heatpump.limittemp is the second available, but it is wrong
  # temperature value in evcc and is displayed as the temperature limit.
#  limittemp:
#    source: modbus
#    uri: {{ joinHostPort .host .port }}
#    id: {{ .id }}
#    register:
#      address: 14
#      type: input
#      decode: int16
#    scale: 0.1

  # 4. Dynamic setpoint for electrical power consumption during PV surplus
  setmaxpower:
    source: modbus
    uri: {{ joinHostPort .host .port }}
    id: {{ .id }}
    register:
      address: 125
      type: writesingle
      decode: uint16

# Register 100 (Betriebsart) is documented by the device as writable, but
# heatpump templates currently have no generic read-only field for arbitrary
# operating modes. It is therefore intentionally not written by this template.
# Values: 0=Aus, 1=Auto, 2=Kühlen, 3=Sommer, 4=Dauerbetrieb,
# 5=Absenkung, 6=Urlaub, 7=Party.

# ==========================================
# CENTRAL HEATPUMP CONFIGURATION
# ==========================================
# Requirement profile: this configuration uses register 125 to provide the power setpoint in watts.
# For the heat pump to react to it, the requirement profile 3 (PV selection set to "Modbus") must be enabled at the heat pump service level.
# Service code "0112" --> WARNING:
# !!!Settings made here can cause damage to the system!!!
