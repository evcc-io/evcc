# ==========================================
# EVCC METERS & CHARGERS CONFIGURATION
# ==========================================
meters:
  # ZWINGEND ERFORDERLICH: Fester Dummy-Wert, damit evcc ohne echten Netzbezugszähler startet.
  - name: dummy_grid
    type: custom
    power:
      source: const
      value: 0

  # 1. Leistungsmessung (Aktuelle Aufnahmeleistung & Energiezähler)
  - name: broetje_heatpump_power
    type: custom
    power:
      source: modbus
      uri: 192.168.2.154:502   
      id: 2                    
      register:
        address: 70  # elektrische Aufnahmeleistung
        type: input  
        decode: uint32
      scale: 1       # Einheit in Watt
    energy:
      source: modbus
      uri: 192.168.2.154:502
      id: 2
      register:
        address: 68  # gesamte elektrische Energie
        type: input
        decode: uint32
      scale: 1       # Einheit in kWh

  # 2. Optionale Daten-Überwachung (Temperaturen)
  - name: broetje_temperatures
    type: custom
    power:
      source: modbus
      uri: 192.168.2.154:502
      id: 2
      register:
        address: 10  # Temp. Außen
        type: input
        decode: int16
      scale: 0.1     # Wert-Multiplikator 0.1 für °C

chargers:
  # Steuerungskomponente für evcc Überschussregelung & Tarifsperre
  - name: broetje_control
    type: custom
    status:
      source: modbus
      uri: 192.168.2.154:502
      id: 2
      register:
        address: 25  # Wärmepumpe läuft (Zustand abfragen)
        type: input
        decode: int16
    
    # -----------------------------------------------------------------
    # SPERRE FÜR DYNAMISCHE STROMTARIFE / NETZSCHONUNG (AKTIVIERT)
    # -----------------------------------------------------------------
    # evcc schreibt hier TRUE (1) für "Erlaubt/Freigabe" bei günstigen Preisen 
    # und FALSE (0) für "Sperre" bei teuren Preisen.
    enabled:
      source: modbus
      uri: 192.168.2.154:502
      id: 2
      register:
        address: 149 # EVU-Freigabe Wert (0 = Blockiert / >0 = Freigegeben)
        type: holding
        decode: int16

    # Dynamische Vorgabe der elektrischen Aufnahmeleistung bei PV-Überschuss
    maxcurrent:
      source: modbus
      uri: 192.168.2.154:502
      id: 2
      register:
        address: 125 # Vorgabe der elektrischen Aufnahmeleistung (Anforderungsprofil 3)
        type: holding
        decode: uint16
      scale: 1       # Einheit in Watt

# ==========================================
# CENTRAL HEATPUMP CONFIGURATION 
# ==========================================
#Anforderungsprofil: Die Konfiguration nutzt Register 125 zur Vorgabe der Watt-Leistung. 
#Damit die Wärmepumpe darauf reagiert, muss an der Fachmannebene der Wärmepumpe 
#das Anforderungsprofil 3 (PV-Auswahl auf "Modbus") aktiviert sein.
#Code für Fachmannebende "0112" --> WARNUNG: 
#!!!Hier können Einstellungen vorgenommen werden, die zu Schäden an der Anlage führen!!!
