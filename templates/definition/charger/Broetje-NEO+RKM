# ==========================================
# EVCC METERS & CHARGERS CONFIGURATION
# ==========================================
template: broetje-neo-rkm
products:
  - brand: Brötje
    description:
      generic: NEO+ RKM
group: heating
capabilities: ["meter", "dim"]

params:
  - name: host
  - name: port
    default: 502
  - name: id
    default: 2

render: |
  type: heatpump


  # 1. Leistungsmessung (Aktuelle Aufnahmeleistung & Energiezähler)
  power:
    source: modbus
    uri: {{ joinHostPort .host .port }}
    id: {{ .id }}
    register:
      address: 70
      type: input
      decode: uint32

  # 2. Optionale Daten-Überwachung (Temperaturen)
  temp:
    source: modbus
    uri: {{ joinHostPort .host .port }}
    id: {{ .id }}
    register:
      address: 10
      type: input
      decode: int16
    scale: 0.1

  # 3. Dynamische Vorgabe der elektrischen Aufnahmeleistung bei PV-Überschuss
  setmaxpower:
    source: modbus
    uri: {{ joinHostPort .host .port }}
    id: {{ .id }}
    register:
      address: 125
      type: writesingle
      decode: uint16   

# ==========================================
# CENTRAL HEATPUMP CONFIGURATION 
# ==========================================
#Anforderungsprofil: Die Konfiguration nutzt Register 125 zur Vorgabe der Watt-Leistung. 
#Damit die Wärmepumpe darauf reagiert, muss an der Fachmannebene der Wärmepumpe 
#das Anforderungsprofil 3 (PV-Auswahl auf "Modbus") aktiviert sein.
#Code für Fachmannebende "0112" --> WARNUNG: 
#!!!Hier können Einstellungen vorgenommen werden, die zu Schäden an der Anlage führen!!!
